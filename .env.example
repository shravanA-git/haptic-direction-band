# Copy to .env (gitignored) and fill in. Never commit real values.
# The app loads .env without overriding variables already set in your shell:
# if a value seems ignored, start with:  env -u CAREGIVER_PHONE -u WEARER_PHONE ...

# Photon 2.0 beta (iMessage), https://photon.codes/beta : a project id and a project API key
PHOTON_PROJECT_ID=pho_prj_xxxxxxxx
PHOTON_API_KEY=pho_sk_xxxxxxxx

# Numbers the band agent will talk to (E.164 like +15551234567, or an iMessage email).
# Anyone else is ignored. On Photon's shared line a number must text the agent first.
WEARER_PHONE=+15551230001
CAREGIVER_PHONE=+15551230002

# LangChain target picker and the band agent (optional: without a key a keyword router answers)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
HDB_BAND_AGENT_MODEL=anthropic:claude-haiku-5-5

# Name the hat listens for (the --name flag wins)
HDB_NAME=Max
